# testing artefacts
.coverage
.coverage.*
htmlcov/
test-results/
e2e-artifacts/

# local scratch / throwaway tooling — never commit
/scratch/
*.bin

# licence signing secret — the private half of the desktop-licence keypair.
# NEVER commit this; with it anyone can mint valid licences for a public build.
# Matches wherever it lands: licensing/ (keygen), or DATA_DIR (portal upload).
private_key.json

# per-machine Claude settings (see CLAUDE.md — must never be committed)
.claude/settings.local.json

# clinic data files brought in for import — belong on the machine, never in the
# repo or on the server (patient/sales data + they bloat every clone)
*.accdb
*.mdb
*.DBF
*.dbf
*.bak
*.xls
*.xlsx
# products.csv is misnamed — it is actually an encrypted Access DB (73MB), not a
# CSV; kept on the machine for import, never in the repo
/products.csv

# Installed UI/UX design skill (local dev tool, not app code)
.claude/skills/

# UI/UX design-system reference (generated, local)
design-system/

# Desktop licence runtime state (written to DATA_DIR; = repo root in dev/test)
license.json

# Source artwork sitting in the repo root — the AI-generated originals the
# login background and the logo were cut from. Nothing references them; the
# shipped versions live in static/img/. Kept on the machine, out of the repo.
/Medical_tech_background_with_ECG*
/minimal-flat-app-icon-logo*

# Owner working documents — kept locally, never committed (same as Sehatyar.docx)
Sehatyar.docx
Hayat LIMS.docx
hayat_lims_text.txt
