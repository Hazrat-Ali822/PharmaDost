# Copy this file to ".env" and fill in real values.
# Local development (default) ----------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production example (PythonAnywhere) --------------------------------
# DJANGO_ENV=production
# DJANGO_SECRET_KEY=<a-long-random-secret>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=pharmadost.pythonanywhere.com
# DJANGO_CSRF_TRUSTED=https://pharmadost.pythonanywhere.com

# ---------------------------------------------------------------------------
# Outbound messaging — both OFF unless set. See messaging/services.py.
# Anything not configured records its messages as SKIPPED, not as a failure.
# ---------------------------------------------------------------------------
# Email (staff: password-reset notices, admin alerts)
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=you@yourdomain.com
# DJANGO_EMAIL_PASSWORD=an-app-password-not-your-login-password
# DJANGO_EMAIL_TLS=True
# DJANGO_EMAIL_FROM=Sehatyar <you@yourdomain.com>

# SMS (patients: appointment reminders, lab-ready, vaccination due).
# Any HTTP gateway works — {to} and {text} are substituted, so switching
# provider is a change here, not in code. Example shape:
# PHARMADOST_SMS_URL=https://api.your-gateway.pk/send
# PHARMADOST_SMS_PARAMS=api_key=YOURKEY&sender=Sehatyar&to={to}&text={text}
# PHARMADOST_SMS_METHOD=GET

# ---------------------------------------------------------------------------
# Failed-login lockout (accounts/lockout.py). Locks the (email, IP) pair, never
# the account alone — otherwise anyone could lock a hospital's staff out.
# ---------------------------------------------------------------------------
# PHARMADOST_LOCKOUT_THRESHOLD=8
# PHARMADOST_LOCKOUT_WINDOW=15
# PHARMADOST_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Error reporting (optional). Without this, a 500 on the host leaves no trace
# anywhere and the first you hear of it is a customer telephoning.
# `pip install sentry-sdk` first; with no DSN the app simply carries on.
# ---------------------------------------------------------------------------
# SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzzz
# SENTRY_ENV=production
